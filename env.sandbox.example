# 운영과 분리된 "테스트 전용" Supabase 프로젝트 값을 넣어주세요.
# 주의: 운영에서 쓰는 URL/KEY를 넣으면 운영 데이터에 영향이 갑니다.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_SANDBOX_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SANDBOX_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SANDBOX_SUPABASE_SERVICE_ROLE_KEY
AUTH_BRIDGE_COOKIE_SECRET=SET_A_LONG_RANDOM_SECRET_FOR_AUTH_BRIDGE
CRON_BACKUP_SECRET=SET_A_LONG_RANDOM_SECRET

# 로컬 분리 서버 포트 (기본값 4100)
PORT=4100

# 분리 모드 표시 (필요 시 UI/로그 구분용)
TUTORWEB_ISOLATED=1
NEXT_PUBLIC_TUTORWEB_ISOLATED=1
TUTORWEB_LOCAL_ONLY=1
NEXT_PUBLIC_TUTORWEB_LOCAL_ONLY=1

# Google Sheets 관리자 OAuth (학습 현황 동기화용)
GOOGLE_SHEETS_OAUTH_CLIENT_ID=
# 선택: 클라이언트가 secret을 발급하는 타입이면 입력
GOOGLE_SHEETS_OAUTH_CLIENT_SECRET=
GOOGLE_SHEETS_OAUTH_REFRESH_TOKEN=
GOOGLE_SHEETS_OWNER_EMAIL=
GOOGLE_SHEETS_PARENT_FOLDER_ID=

# 시트 메뉴(Apps Script) 호출 보호
LEARNING_SHEET_MENU_SECRET=SET_A_LONG_RANDOM_SECRET
CRON_LEARNING_SHEET_SECRET=
